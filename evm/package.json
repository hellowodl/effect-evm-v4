{
  "name": "effect-evm-v4",
  "description": "Effect v4 integration for Ethereum Virtual Machine (EVM) frontend development",
  "homepage": "https://github.com/hellowodl/effect-evm-v4/tree/main/evm#readme",
  "main": "./dist/index.js",
  "sideEffects": false,
  "type": "module",
  "types": "./dist/index.d.ts",
  "version": "0.1.0",
  "scripts": {
    "build": "just build",
    "prepack": "bun install --frozen-lockfile && just build"
  },
  "author": {
    "name": "Paul Razvan Berg",
    "url": "https://github.com/PaulRBerg"
  },
  "contributors": [
    {
      "name": "Maximiliaan van Dijk",
      "url": "https://github.com/hellowodl"
    }
  ],
  "license": "MIT",
  "repository": {
    "directory": "evm",
    "type": "git",
    "url": "git+https://github.com/hellowodl/effect-evm-v4.git"
  },
  "bugs": {
    "url": "https://github.com/hellowodl/effect-evm-v4/issues"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@effect/vitest": "4.0.0-beta.102",
    "@prb/devkit": "^1.0.0",
    "@types/node": "^25.0.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript/native-preview": "^7.0.0-dev.20260118.1",
    "@vitest/ui": "^4.1.10",
    "@wagmi/core": "^2.22.1",
    "effect": "4.0.0-beta.102",
    "jsdom": "^24.1.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "typescript": "^5.9.3",
    "viem": "^2.43.1",
    "vitest": "^4.1.10",
    "wagmi": "^2.19.5"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./react-hooks/convenience": {
      "types": "./dist/integrations/react-hooks/convenience/index.d.ts",
      "import": "./dist/integrations/react-hooks/convenience/index.js",
      "default": "./dist/integrations/react-hooks/convenience/index.js"
    },
    "./internal": null,
    "./internal/*": null,
    "./*": {
      "types": "./dist/*/index.d.ts",
      "import": "./dist/*/index.js",
      "default": "./dist/*/index.js"
    }
  },
  "files": [
    "dist/**",
    "CHANGELOG.md",
    "DOCS.md",
    "LICENSE",
    "NOTICE",
    "README.md",
    "banner.png"
  ],
  "keywords": [
    "effect",
    "effect-ts",
    "ethereum",
    "evm",
    "react",
    "typescript",
    "viem",
    "wagmi",
    "web3"
  ],
  "peerDependencies": {
    "@wagmi/core": ">=2.0.0",
    "effect": "^4.0.0-beta.102",
    "react": ">=18.2.0",
    "react-dom": ">=18.2.0",
    "viem": "^2.43",
    "vitest": ">=4.1.0"
  },
  "peerDependenciesMeta": {
    "@wagmi/core": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "imports": {
    "#src/*": "./dist/*"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
